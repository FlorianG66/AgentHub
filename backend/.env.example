# ============================================================
# SynergyAI / AgentHub — Variables d'environnement (backend)
# Copiez ce fichier en `.env` et adaptez les valeurs.
# Ne COMMITTEZ JAMAIS le fichier `.env` (ignoré par .gitignore).
# ============================================================

# --- Environnement & projet ---
# development | production
APP_ENV=development
PROJECT_NAME=SynergyAI - AgentHub API
# URL du frontend (utilisée pour construire les liens de réinitialisation)
FRONTEND_URL=http://localhost:3000

# --- Base de données ---
# SQLite (défaut, développement) :
DATABASE_URL=sqlite+aiosqlite:///./platform.db
# PostgreSQL (production / Render) — l'URL est normalisée pour asyncpg :
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Sécurité JWT ---
# OBLIGATOIRE en production : valeur aléatoire longue (ex: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=dev-secret-key-change-moi-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Comptes seedés de démonstration (créés au premier démarrage) ---
# En production, changez ces mots de passe ou désactivez l'ajout des seeds.
SEED_ADMIN_EMAIL=admin@agenthub.local
SEED_ADMIN_PASSWORD=admin123
SEED_CLIENT_EMAIL=contact@boulangerie.com
SEED_CLIENT_PASSWORD=client123
# Masquer les comptes de démo sur le login public (lien de visu)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
# Activer l'affichage des comptes de démo sur un déploiement public permanent (Vercel) :
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# --- Notifications e-mail ---
# console : le jeton de reset / invitation est renvoyé dans la réponse API (démo)
# smtp :    envoi réel via un serveur SMTP
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@agenthub.local
SMTP_USE_TLS=true

# --- IA / LLM optionnel ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGIN_REGEX=https://(.*\.trycloudflare\.com|.*\.vercel\.app)